  "scripts": {
    "serve": "vue-cli-service serve",
    "js:build": "node -e \"require('./modules/CoreWebclient/gulp-tasks/javascript.js').default.build()\"",
    "js:min": "node -e \"require('./modules/CoreWebclient/gulp-tasks/javascript.js').default.min()\"",
    "js:watch": "node -e \"require('./modules/CoreWebclient/gulp-tasks/javascript.js').default.watch()\"",
    "styles:build": "node -e \"require('./modules/CoreWebclient/gulp-tasks/styles.js').default.build()\"",
    "styles:cssonly": "node -e \"require('./modules/CoreWebclient/gulp-tasks/styles.js').default.cssonly()\"",
    "styles:watch": "node -e \"require('./modules/CoreWebclient/gulp-tasks/styles.js').default.watch()\"",
    "test:e2e-desktop": "./modules/CoreWebclient/test/e2e/run.sh",
    "test:e2e-desktop:ui": "node modules/CoreWebclient/test/e2e/scripts/run-e2e.js --ui",
    "test:e2e-desktop:report": "playwright show-report modules/CoreWebclient/test/e2e/playwright-report",
    "test:e2e-desktop:install-browsers": "playwright install chromium firefox webkit",
    "test:e2e-mobile": "node modules/CoreMobileWebclient/vue-mobile/test/e2e/scripts/playwright-cli.js test",
    "test:e2e-mobile:ui": "node modules/CoreMobileWebclient/vue-mobile/test/e2e/scripts/playwright-cli.js test --ui",
    "test:e2e-mobile:report": "playwright show-report modules/CoreMobileWebclient/vue-mobile/playwright-report",
    "test:e2e-mobile:install-browsers": "playwright install chromium webkit"
